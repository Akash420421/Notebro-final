# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: High-speed inference key for Llama 3.3 70B, DeepSeek R1, Mixtral
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# NVIDIA_API_KEY: NVIDIA NIM API key for Nemotron and Llama 3.3 models
NVIDIA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================
# SUPABASE CONNECTION (CLOUD BACKEND & AUTH)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL: Supabase Project URL (found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://zvuhkrljizbvckojhfyg.supabase.co"

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Supabase anon/public key (safe for browser use)
# NEVER use service_role key in client-side code
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# VITE aliases (Vite uses VITE_ prefix; code supports both for maximum compatibility)
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Database Direct Connection (for server-side / Postgres client tools only)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Password (direct SQL / psql connection):
SUPABASE_DB_PASSWORD="YOUR_SUPABASE_DB_PASSWORD"
